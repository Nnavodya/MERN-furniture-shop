# Copy to .env and fill in real values (never commit .env)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/furnihub?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string_at_least_16_chars
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini (AI Room Analyzer)
GEMINI_API_KEY=your_gemini_api_key

# Stripe (optional / demo mode)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Email (optional — falls back to console logging in dev)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
